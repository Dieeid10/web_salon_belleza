<section data-google-login aria-label="Acceso de clientas">
  <p data-status role="status" aria-live="polite">Comprobando sesión…</p>
  <button data-login type="button" disabled>Ingresar con Google</button>
  <button data-logout type="button" hidden>Cerrar sesión</button>
  <noscript>Activá JavaScript para ingresar con Google.</noscript>
</section>

<script>
  import { getSupabase } from '../lib/supabase';
  import type { Session } from '@supabase/supabase-js';

  async function setup(root: HTMLElement) {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const login = root.querySelector<HTMLButtonElement>('[data-login]')!;
    const logout = root.querySelector<HTMLButtonElement>('[data-logout]')!;
      
    try {
      const supabase = getSupabase();
      function render(session: Session | null) {
        login.hidden = Boolean(session);
        logout.hidden = !session;
        login.disabled = false;
        logout.disabled = false;
        status.textContent = session
          ? `Sesión iniciada${session.user.email ? ' como ' + session.user.email : ''}.`
          : 'Ingresá con tu cuenta de Google.';
      }
      login.addEventListener('click', async () => {
        login.disabled = true;
        status.textContent = 'Conectando con Google…';
        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: new URL('/auth/google/callback', window.location.origin).href,
            },
          });
          if (error) throw error;
        } catch {
          status.textContent = 'No se pudo iniciar el acceso con Google. Intentá nuevamente.';
          login.disabled = false;
        }
      });
      logout.addEventListener('click', async () => {
        logout.disabled = true;
        try {
          const { error } = await supabase.auth.signOut({ scope: 'local' });
          if (error) throw error;
          render(null);
        } catch {
          status.textContent = 'No se pudo cerrar la sesión. Intentá nuevamente.';
          logout.disabled = false;
        }
      });
      supabase.auth.onAuthStateChange((_event, session) => render(session));
      const { data, error } = await supabase.auth.getSession();
      if (error) throw error;
      render(data.session);
    } catch {
      status.textContent = 'No se pudo preparar el acceso. Revisá la configuración o recargá la página.';
      login.disabled = true;
    }
  }
  document.querySelectorAll<HTMLElement>('[data-google-login]').forEach(root => {
    void setup(root);
  });
</script>
