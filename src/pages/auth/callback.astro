---
const title = 'Activar cuenta de vendedor | Salón';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
	</head>
	<body>
		<main class="activation">
			<a class="brand" href="/" aria-label="Salón, inicio">SALÓN <span>/</span> EQUIPO</a>
			<div class="rule"></div>
			<p class="eyebrow">ACCESO AL ESCRITORIO</p>
			<h1>Activa tu cuenta</h1>
			<p class="intro">
				La invitación está validada. Crea una contraseña personal para ingresar
				a la aplicación de gestión del salón.
			</p>

			<div id="status" class="status" role="status" aria-live="polite">
				Validando invitación…
			</div>

			<form id="password-form" class="password-form" hidden>
				<label for="password">Nueva contraseña</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="new-password"
					minlength="8"
					required
				/>
				<label for="password-confirmation">Repetir contraseña</label>
				<input
					id="password-confirmation"
					name="password-confirmation"
					type="password"
					autocomplete="new-password"
					minlength="8"
					required
				/>
				<p class="hint">Usa al menos 8 caracteres.</p>
				<button id="submit-button" type="submit">Guardar contraseña</button>
			</form>

			<p class="footnote">Después podrás iniciar sesión desde la aplicación de escritorio.</p>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		min-width: 320px;
		background: #f3f5f2;
		color: #202b26;
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}

	:global(body) {
		min-height: 100vh;
		margin: 0;
		display: grid;
		place-items: center;
		padding: 24px;
		background-image: linear-gradient(135deg, #f3f5f2 0%, #e6eee8 100%);
	}

	.activation {
		width: min(100%, 480px);
		padding: 38px;
		background: #fff;
		border: 1px solid #d5dfd8;
		border-radius: 8px;
		box-shadow: 0 18px 55px rgb(34 56 43 / 10%);
		animation: appear 280ms ease-out both;
	}

	.brand {
		color: #315a46;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 1.4px;
		text-decoration: none;
	}

	.brand span {
		padding: 0 5px;
		color: #d1844f;
	}

	.rule {
		width: 46px;
		height: 3px;
		margin: 24px 0 28px;
		background: #d1844f;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #52715f;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.1px;
	}

	h1 {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 34px;
		font-weight: 500;
	}

	.intro {
		margin: 14px 0 24px;
		color: #58665e;
		font-size: 15px;
		line-height: 1.6;
	}

	.password-form {
		display: grid;
		gap: 9px;
	}

	.password-form[hidden] {
		display: none;
	}

	label {
		margin-top: 7px;
		font-size: 13px;
		font-weight: 650;
	}

	input {
		width: 100%;
		min-height: 44px;
		padding: 10px 12px;
		border: 1px solid #b9c9bf;
		border-radius: 5px;
		background: #fff;
		color: inherit;
		font: inherit;
	}

	input:focus {
		border-color: #315a46;
		outline: 3px solid rgb(49 90 70 / 15%);
	}

	.hint,
	.footnote {
		color: #68756d;
		font-size: 12px;
		line-height: 1.5;
	}

	.hint {
		margin: 0 0 8px;
	}

	button {
		min-height: 46px;
		border: 0;
		border-radius: 5px;
		background: #315a46;
		color: #fff;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	button:hover:not(:disabled) {
		background: #244735;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.status {
		padding: 12px 14px;
		border-left: 3px solid #d1844f;
		background: #f5f7f3;
		color: #394a3f;
		font-size: 14px;
		line-height: 1.5;
	}

	.status[data-state='error'] {
		border-color: #b5473c;
		background: #fbf1ef;
		color: #842d25;
	}

	.status[data-state='success'] {
		border-color: #43835d;
		background: #edf5ef;
		color: #285d3b;
	}

	.footnote {
		margin: 24px 0 0;
	}

	@keyframes appear {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 520px) {
		.activation { padding: 28px 22px; }
		h1 { font-size: 30px; }
	}
</style>

<script>
	const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
	const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
	const statusBox = document.querySelector<HTMLDivElement>('#status');
	const form = document.querySelector<HTMLFormElement>('#password-form');
	const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');

	function showStatus(message: string, state: 'info' | 'error' | 'success' = 'info') {
		if (!statusBox) return;
		statusBox.textContent = message;
		statusBox.dataset.state = state;
	}

	async function responseError(response: Response) {
		try {
			const payload = await response.json();
			return payload.msg ?? payload.message ?? 'No se pudo validar la invitación.';
		} catch {
			return 'No se pudo validar la invitación.';
		}
	}

	async function getInvitationAccessToken(): Promise<string> {
		const fragment = new URLSearchParams(window.location.hash.slice(1));
		const query = new URLSearchParams(window.location.search);
		const providerError = fragment.get('error_description') ?? query.get('error_description');
		if (providerError) throw new Error(providerError.replaceAll('+', ' '));

		const fragmentToken = fragment.get('access_token');
		if (fragmentToken) return fragmentToken;

		const tokenHash = query.get('token_hash');
		if (tokenHash && supabaseUrl && supabaseAnonKey) {
			const verification = await fetch(`${supabaseUrl}/auth/v1/verify`, {
				method: 'POST',
				headers: {
					'apikey': supabaseAnonKey,
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({ token_hash: tokenHash, type: 'invite' }),
			});
			if (!verification.ok) throw new Error(await responseError(verification));
			const session = await verification.json();
			if (session.access_token) return session.access_token;
		}

		throw new Error('El enlace no contiene una invitación válida o ya venció. Solicita otra invitación.');
	}

	if (!supabaseUrl || !supabaseAnonKey) {
		showStatus('Falta configurar PUBLIC_SUPABASE_URL o PUBLIC_SUPABASE_ANON_KEY en el frontend.', 'error');
	} else {
		try {
			const accessToken = await getInvitationAccessToken();
			// Elimina tokens temporales del historial visible sin afectar la sesión validada.
			window.history.replaceState({}, document.title, window.location.pathname);
			showStatus('Invitación validada. Elige una contraseña para tu cuenta.');
			if (form) form.hidden = false;

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const password = new FormData(form).get('password')?.toString() ?? '';
				const confirmation = new FormData(form).get('password-confirmation')?.toString() ?? '';
				if (password !== confirmation) {
					showStatus('Las contraseñas no coinciden.', 'error');
					return;
				}
				if (submitButton) submitButton.disabled = true;
				showStatus('Guardando contraseña…');
				try {
					const update = await fetch(`${supabaseUrl}/auth/v1/user`, {
						method: 'PUT',
						headers: {
							'apikey': supabaseAnonKey,
							'Authorization': `Bearer ${accessToken}`,
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ password }),
					});
					if (!update.ok) throw new Error(await responseError(update));
					form.hidden = true;
					showStatus('Contraseña creada. Ya puedes iniciar sesión en la aplicación de escritorio.', 'success');
				} catch (error) {
					showStatus(error instanceof Error ? error.message : 'No se pudo guardar la contraseña.', 'error');
					if (submitButton) submitButton.disabled = false;
				}
			});
		} catch (error) {
			window.history.replaceState({}, document.title, window.location.pathname);
			showStatus(error instanceof Error ? error.message : 'No se pudo validar la invitación.', 'error');
		}
	}
</script>